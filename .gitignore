.DS_Store
node_modules/
dist/
*.zip
*.crx
*.pem
dist-policy/
dev-config.json
!dev-config.example.json

# Screenshot and trace artifacts left by browser-driving review agents.
.playwright-mcp/

# Verified CRX upload signing key. Losing it means a week with Chrome Web Store support,
# and committing it means anyone can sign a package as you. Ignored here rather than by a
# .gitignore inside the directory, because that file would match its own '*' rule, never be
# committed, and so protect nothing in a fresh clone.
.crx-key/
*.pem
!examples/*.pem
